# Call Analysis OS V2 — environment. Separate from the V1 project; never copy V1 values here.
# ── database (fresh, V2-only) ─────────────────────────────────────────
DATABASE_URL=postgres://cas_app:PASSWORD@HOST:5432/call_analysis_os_v2
MIGRATE_DATABASE_URL=postgres://OWNER:PASSWORD@HOST:5432/call_analysis_os_v2
APP_DB_ROLE=cas_app
APP_DB_PASSWORD=
# deployment form (wins over DATABASE_URL when DB_HOST is set): DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD DB_SSL DB_SSL_CA
# ── app ───────────────────────────────────────────────────────────────
APP_ORIGIN=https://calls.example.com
# public URL Studio uses to download recordings and post results back (must be reachable from the internet)
PUBLIC_APP_URL=https://calls.example.com
STORAGE_DIR=./storage
SIGNUP_OPEN=true
# comma-separated emails that get the Platform console (all organisations)
PLATFORM_ADMIN_EMAILS=
TRUST_PROXY_HOPS=0
# ── secrets (generate fresh per environment) ──────────────────────────
AUTH_PEPPER=
FILE_LINK_SECRET=
FIELD_KEY=
INBOUND_TOKEN=
# ── Pucho Studio flows (empty = not connected; the app says so, never simulates) ──
WEBHOOK_CALL_PROCESSING=
WEBHOOK_SOP_EXTRACTION=
WEBHOOK_EMAIL=
